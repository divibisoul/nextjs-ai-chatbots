# Generate a random secret for production deployment
AUTH_SECRET=change-me-in-production

# xAI API key for the existing N04 model integration
XAI_API_KEY=your_xai_api_key

# Vercel Blob
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token

# PostgreSQL
POSTGRES_URL=your_postgres_url

# Redis
REDIS_URL=your_redis_url

# Soul Mesh security
SOUL_MESH_HMAC_SECRET=change-me-in-production
SOUL_MESH_TOKEN=change-me-in-production

# N04 outbound peer endpoints. Each endpoint must expose POST /api/soul-mesh.
SOUL_MESH_N01_URL=
SOUL_MESH_N02_URL=
SOUL_MESH_N03_URL=
SOUL_MESH_N05_URL=
SOUL_MESH_N06_URL=
NEXT_PUBLIC_MESH_GATEWAY_URL=

# Supabase metadata storage (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_STORAGE_TABLE=soul_storage_records

# Hybrid Supabase + IPFS storage
WEB3_STORAGE_TOKEN=your_web3_storage_token
WEB3_STORAGE_API_URL=https://api.web3.storage
WEB3_STORAGE_GATEWAY_URL=https://w3s.link/ipfs
